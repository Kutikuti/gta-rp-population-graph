#!/usr/bin/env bash
# Root-owned helper. It must only be installed in /usr/local/sbin by jrechau.
# It never executes release-provided code, hooks, npm, or migrations as root.
set -euo pipefail
umask 022

if (( $# != 1 )); then
  echo "Usage: $0 <nom-release>" >&2
  exit 2
fi

readonly release="$1"
readonly application_root="/var/www/gta-rp-population-graph"
readonly staging_path="${application_root}/staging/${release}"
readonly releases_path="${application_root}/releases"
readonly release_path="${releases_path}/${release}"
readonly current_path="${application_root}/current"
readonly next_path="${application_root}/current.next"
readonly health_url="http://127.0.0.1:4000/api/health"

if [[ ! "${release}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  echo "Nom de release invalide" >&2
  exit 2
fi

if [[ ! -d "${staging_path}" || -L "${staging_path}" ||
      ! -f "${staging_path}/backend/dist/index.js" ||
      ! -f "${staging_path}/web-client/dist/index.html" ]]; then
  echo "Staging GTA incomplet ou introuvable" >&2
  exit 1
fi

if [[ -e "${release_path}" || -L "${release_path}" ||
      -e "${next_path}" || -L "${next_path}" ]]; then
  echo "Release ou lien temporaire deja present" >&2
  exit 1
fi

if [[ ! -L "${current_path}" ]]; then
  echo "Release courante absente : rollback impossible" >&2
  exit 1
fi

readonly previous_target="$(readlink "${current_path}")"
if [[ -z "${previous_target}" ]]; then
  echo "Cible de release courante invalide" >&2
  exit 1
fi

exec 9>"/run/gta-rp-activate-release.lock"
flock -n 9 || { echo "Activation GTA deja en cours" >&2; exit 1; }

switched=false
committed=false

rollback() {
  local status=$?
  trap - EXIT

  if [[ "${switched}" == true && "${committed}" != true ]]; then
    echo "Activation GTA echouee ; retour a la release precedente" >&2
    rm -f -- "${next_path}"
    ln -s "${previous_target}" "${next_path}"
    mv -Tf "${next_path}" "${current_path}"
    systemctl restart gta-rp-backend.service || status=1
  fi

  if [[ "${committed}" != true ]]; then
    rm -rf -- "${release_path}"
  fi
  rm -f -- "${next_path}"
  exit "${status}"
}
trap rollback EXIT

mkdir -p "${release_path}"
cp -a --no-preserve=ownership "${staging_path}/." "${release_path}/"
rm -f -- "${release_path}/backend/.env"
chown -hR root:gta-rp-runtime "${release_path}"
find "${release_path}" -xdev -type d -exec chmod 0755 {} +
# Preserve only executable bits that were already present in staging: esbuild
# and some Node binaries need them at runtime. All other files remain read-only.
find "${release_path}" -xdev -type f -perm /0111 -exec chmod 0755 {} +
find "${release_path}" -xdev -type f ! -perm /0111 -exec chmod 0644 {} +

ln -s "releases/${release}" "${next_path}"
mv -Tf "${next_path}" "${current_path}"
switched=true

systemctl restart gta-rp-backend.service
for _ in {1..10}; do
  if systemctl is-active --quiet gta-rp-backend.service &&
    curl --fail --silent --show-error --connect-timeout 1 --max-time 3 \
      "${health_url}" | grep -Eq '"status"[[:space:]]*:[[:space:]]*"ok"'; then
    committed=true
    echo "Release GTA ${release} activee et saine."
    exit 0
  fi
  sleep 1
done

echo "Backend GTA non sain apres activation" >&2
exit 1
