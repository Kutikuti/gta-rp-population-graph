#!/usr/bin/env bash
set -euo pipefail
umask 077

# Root-owned shared helper. Backup paths and container are fixed to prevent a
# caller from mounting arbitrary host paths into Docker.
readonly container_name="postgres_db"
readonly f1_backup_root="/var/www/f1-paris-project/shared/backups/postgres"
readonly gta_backup_root="/var/www/gta-rp-population-graph/shared/backups/postgres"
(( $# == 0 )) || { echo "This helper accepts no arguments." >&2; exit 2; }

database_user="$(docker exec "${container_name}" printenv POSTGRES_USER)"
database_password="$(docker exec "${container_name}" printenv POSTGRES_PASSWORD)"
temporary_databases=()
cleanup() {
  local database
  for database in "${temporary_databases[@]}"; do
    docker exec "${container_name}" dropdb --if-exists --force -U "${database_user}" "${database}" >/dev/null 2>&1 || true
  done
}
trap cleanup EXIT

restore_latest() {
  local application="$1" backup_root="$2" latest_backup temporary_database table_count
  latest_backup="$(find "${backup_root}" -type f -name '*.dump' -printf '%T@ %p\n' | sort -nr | head -n 1 | cut -d ' ' -f 2-)"
  [[ -n "${latest_backup}" ]] || { echo "Aucun dump trouve pour ${application}." >&2; return 1; }
  temporary_database="platform_restore_${application//-/_}_$$"
  docker exec "${container_name}" dropdb --if-exists --force -U "${database_user}" "${temporary_database}"
  docker exec "${container_name}" createdb -U "${database_user}" "${temporary_database}"
  temporary_databases+=("${temporary_database}")
  export PGPASSWORD="${database_password}"
  docker run --rm --network "container:${container_name}" --volume "${latest_backup}:/backup.dump:ro" --env PGPASSWORD postgres:16-alpine \
    pg_restore --exit-on-error --no-owner --no-privileges --host 127.0.0.1 --username "${database_user}" --dbname "${temporary_database}" /backup.dump
  table_count="$(docker exec "${container_name}" psql -U "${database_user}" -d "${temporary_database}" -Atc "SELECT count(*) FROM pg_catalog.pg_tables WHERE schemaname = 'public'")"
  docker exec "${container_name}" dropdb --if-exists --force -U "${database_user}" "${temporary_database}"
  temporary_databases=("${temporary_databases[@]:0:${#temporary_databases[@]}-1}")
  (( table_count >= 1 )) || { echo "Restauration ${application} sans table publique." >&2; return 1; }
  echo "Restauration ${application} validee : ${table_count} tables depuis ${latest_backup}."
}

restore_latest f1-paris "${f1_backup_root}"
restore_latest gta-rp "${gta_backup_root}"
