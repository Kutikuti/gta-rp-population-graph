[Unit]
Description=GTA RP photo draft cleanup

[Service]
Type=oneshot
User=gta-rp-runtime
Group=gta-rp-runtime
WorkingDirectory=/var/www/gta-rp-population-graph/current/backend
EnvironmentFile=/var/www/gta-rp-population-graph/shared/config/runtime.env
Environment=PATH=/opt/node-gta-rp/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# The promoted release intentionally makes regular files non-executable.
# Invoke the tsx CLI through the fixed Node runtime rather than npm's .bin shim.
ExecStart=/opt/node-gta-rp/bin/node node_modules/tsx/dist/cli.mjs src/cleanup-photo-drafts.ts
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/www/gta-rp-population-graph/shared/storage/uploads/tmp
